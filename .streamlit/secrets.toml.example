# Copy this template to .streamlit/secrets.toml for local development.
# Keep real credentials only in that ignored file or your hosting secrets panel.
# See docs/LIVE_TEST_SETUP.md for instructions.

# Supabase > Connect > Session pooler: paste the full PostgreSQL URI.
# Replace the password placeholder and percent-encode reserved password characters.
# Set this to enable Supabase. An empty value uses local SQLite.
DATABASE_URL = ""

# Leave empty until you choose your own admin credentials.
ADMIN_USERNAME = ""
ADMIN_PASSWORD = ""
